# ==============================================================================
# Redmine MCP Server Configuration
# ==============================================================================
# Copy this file to .env and update the values as needed.

# ------------------------------------------------------------------------------
# 1. AUTHENTICATION MODE
# ------------------------------------------------------------------------------
# Choose how the server should authenticate with Redmine:
# - legacy: Use a single fixed API Key or Username/Password (default).
# - oauth:  Use per-user OAuth2 tokens (Requires Redmine 6.1+).
# - dynamic: AI Agent provides URL and API Key per request via headers (Multi-tenant).
# NOTE: For public VPS deployments, prefer oauth/dynamic. Legacy on public bind is
# blocked by default unless REDMINE_ALLOW_INSECURE_LEGACY_PUBLIC=true is set.
REDMINE_AUTH_MODE=legacy

# ------------------------------------------------------------------------------
# 2. FIXED MODE CONFIGURATION (Only for 'legacy' or 'oauth')
# ------------------------------------------------------------------------------
# [OPTIONAL for 'dynamic' mode - Headers will override these values]

# Base URL of your Redmine instance
# REDMINE_URL=https://your-redmine-server.com

# Only for 'legacy' mode: API Key (Recommended) or Username/Password
# REDMINE_API_KEY=your_api_key
# REDMINE_USERNAME=your_username
# REDMINE_PASSWORD=your_password

# Only for 'oauth' mode: Public base URL of this MCP server
# REDMINE_MCP_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. SERVER NETWORKING
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Public hostname/IP used for generating download URLs for files
# Prefer setting PUBLIC_BASE_URL in production (e.g. https://mcp.example.com)
PUBLIC_BASE_URL=
PUBLIC_HOST=localhost
PUBLIC_PORT=8000
PUBLIC_SCHEME=https

# ------------------------------------------------------------------------------
# 4. FILE & ATTACHMENT MANAGEMENT
# ------------------------------------------------------------------------------
# Directory where downloaded attachments are temporarily stored
ATTACHMENTS_DIR=./attachments

# Automatic cleanup settings
AUTO_CLEANUP_ENABLED=true
CLEANUP_INTERVAL_MINUTES=10
ATTACHMENT_EXPIRES_MINUTES=60

# ------------------------------------------------------------------------------
# 5. ADVANCED SETTINGS
# ------------------------------------------------------------------------------
# Block all write operations (create/update/delete)
REDMINE_MCP_READ_ONLY=false

# Auto-fill missing required custom fields on issue creation
REDMINE_AUTOFILL_REQUIRED_CUSTOM_FIELDS=false
# REDMINE_REQUIRED_CUSTOM_FIELD_DEFAULTS={}

# ------------------------------------------------------------------------------
# 5b. TOOL TOGGLES
# ------------------------------------------------------------------------------
# Disable wiki-related tools (get/create/update/delete wiki pages).
# When true, wiki tools are removed from the MCP server and
# search_entire_redmine will not search wiki-pages.
REDMINE_MCP_DISABLE_WIKI_TOOLS=false

# ------------------------------------------------------------------------------
# 6. SECURITY (SSRF Protection)
# ------------------------------------------------------------------------------
# SSRF protection to prevent access to internal IPs (Default: true)
# Set to false ONLY for local development with Redmine on localhost.
REDMINE_SECURITY_STRICT=true

# Optional: List of trusted Redmine hostnames (comma-separated)
# e.g., redmine.example.com,work.mycorp.net
# REDMINE_ALLOWED_HOSTS=

# Safety guard: prevent accidental public exposure in legacy mode.
REDMINE_ALLOW_INSECURE_LEGACY_PUBLIC=false

# OAuth revoke endpoint policy:
# - false (recommended): requires Authorization: Bearer <token>
# - true: allows unauthenticated body token revocation (trusted internal networks only)
REDMINE_ALLOW_UNAUTHENTICATED_REVOKE=false

# SSL Configuration (Use only if your Redmine uses internal/self-signed certs)
REDMINE_SSL_VERIFY=true
# REDMINE_SSL_CERT=/path/to/ca-bundle.crt
# REDMINE_SSL_CLIENT_CERT=/path/to/client.pem,/path/to/key.pem
