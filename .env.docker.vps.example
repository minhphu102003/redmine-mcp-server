# Copy to .env.docker and edit for your VPS.

# --- Auth mode ---
# Public deployments should use oauth or dynamic.
REDMINE_AUTH_MODE=dynamic

# --- Redmine upstream ---
# For oauth/legacy set your fixed URL:
# REDMINE_URL=https://redmine.example.com

# --- Server bind (internal in container) ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Public URL for generated file links ---
PUBLIC_BASE_URL=https://mcp.example.com
PUBLIC_SCHEME=https
PUBLIC_HOST=mcp.example.com
PUBLIC_PORT=443

# --- Runtime hardening toggles ---
REDMINE_ALLOW_INSECURE_LEGACY_PUBLIC=false
REDMINE_ALLOW_UNAUTHENTICATED_REVOKE=false
REDMINE_SECURITY_STRICT=true
# Optional explicit allowlist for dynamic mode targets:
# REDMINE_ALLOWED_HOSTS=redmine.example.com

# --- Optional safety mode ---
REDMINE_MCP_READ_ONLY=false

# --- Tool toggles ---
# Disable wiki tools (get/create/update/delete wiki pages)
REDMINE_MCP_DISABLE_WIKI_TOOLS=false

# --- TLS/SSL to Redmine ---
REDMINE_SSL_VERIFY=true
# REDMINE_SSL_CERT=/app/data/certs/ca.crt
# REDMINE_SSL_CLIENT_CERT=/app/data/certs/client.pem,/app/data/certs/client.key
