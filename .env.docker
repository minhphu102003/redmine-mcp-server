# Redmine MCP Docker Configuration
# ------------------------------------------------------------------------------

# 1. AUTHENTICATION MODE
# Options: legacy, oauth, dynamic
REDMINE_AUTH_MODE=dynamic

# 2. FIXED MODE CONFIGURATION (Commented out in Dynamic Mode)
# # REDMINE_URL=https://your-redmine-server.com
# # REDMINE_API_KEY=your_api_key

# 3. SERVER NETWORKING
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
PUBLIC_HOST=localhost
PUBLIC_PORT=8000

# 4. FILE MANAGEMENT
ATTACHMENTS_DIR=./attachments
AUTO_CLEANUP_ENABLED=true
CLEANUP_INTERVAL_MINUTES=10
ATTACHMENT_EXPIRES_MINUTES=60

# 5. ADVANCED
REDMINE_MCP_READ_ONLY=false
REDMINE_SSL_VERIFY=true

# 5b. TOOL TOGGLES
# Disable wiki tools (get/create/update/delete wiki pages)
REDMINE_MCP_DISABLE_WIKI_TOOLS=true

# 5c. GOOGLE SHEETS
GOOGLE_SHEETS_CREDENTIALS_FILE=/app/credentials/service-account.json

# 6. SECURITY
# Redmine host resolves to a private/internal IP (e.g. school intranet).
# Disable strict SSRF checks to allow it; use only on trusted networks.
REDMINE_SECURITY_STRICT=false
