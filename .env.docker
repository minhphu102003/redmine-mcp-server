# Redmine MCP VPS configuration (Docker + Caddy)
# Copy-safe defaults for dynamic mode.

# --- Auth mode ---
REDMINE_AUTH_MODE=dynamic

# --- Public URL used for generated download links ---
# Replace with your real public domain served by Caddy.
PUBLIC_BASE_URL=https://mcp.example.com
PUBLIC_HOST=mcp.example.com
PUBLIC_PORT=443

# --- Redmine target restrictions (highly recommended) ---
# Comma-separated allowlist for dynamic mode destinations.
# Example: redmine.company.com,redmine.partner.com
REDMINE_ALLOWED_HOSTS=redmine.example.com

# --- Runtime behavior ---
REDMINE_SSL_VERIFY=true
REDMINE_MCP_READ_ONLY=false

# --- File cleanup ---
AUTO_CLEANUP_ENABLED=true
CLEANUP_INTERVAL_MINUTES=10
ATTACHMENT_EXPIRES_MINUTES=60

# --- Optional TLS customization for upstream Redmine ---
# REDMINE_SSL_CERT=/app/data/certs/ca.crt
# REDMINE_SSL_CLIENT_CERT=/app/data/certs/client.pem,/app/data/certs/client.key
